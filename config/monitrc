# VPSリソース監視（メモリ・スワップ・CPU負荷）
#
# 通知は Healthchecks（死活監視）へ送る（環境変数 HC_PING_URL を設定した場合のみ。未設定なら無効）。
#   - 異常を検知したとき: 即時に /fail を送る（hc-notify fail）
#   - 5周期ごと: 現在の状態を送る（hc-notify beat）。途絶えたら Healthchecks 側が検知する
# 未設定でも /var/log/monit.log とステータス画面（ローカルのみ）で確認できる。
# 閾値は初期値。実際の運用データを見ながら調整する想定。

# コンテナ環境のため start delay は設けない（ホスト再起動時のなだれ防止用オプション。
# これがあると httpd が30秒 LISTEN せず、Kamal の deploy_timeout 内にヘルスチェックが通らない）
set daemon 60

set log /var/log/monit.log

set idfile /var/lib/monit/id
set statefile /var/lib/monit/state

# monit CLI（`monit status` 等）が接続する制御用 httpd。コンテナ内 localhost のみ許可。
# 日常の確認は `kamal status`（= コンテナ内 monit status）で行う。ブラウザ閲覧はしない。
set httpd port 2812 and
    use address localhost
    allow localhost

check system vps-host
    if memory usage > 90% for 5 cycles then exec "/usr/local/bin/hc-notify fail"
    if swap usage > 70% for 5 cycles then exec "/usr/local/bin/hc-notify fail"
    if loadavg (5min) > 4 for 5 cycles then exec "/usr/local/bin/hc-notify fail"
    if cpu usage (user) > 90% for 10 cycles then exec "/usr/local/bin/hc-notify fail"

# 定期的な状態通知（5周期 = 約5分）。サービス名は bin/hc-notify の HEARTBEAT_SERVICE と揃える。
# hc-notify は常に exit 0 を返す。Monit は program チェックに判定ルールを必須とするため置いているだけで、
# 通知先は設定していないので、発火してもログに残るのみ。
check program hc-heartbeat with path "/usr/local/bin/hc-notify beat"
    every 5 cycles
    if status != 0 then alert
